<script>
(function(){
  var form = document.getElementById('booking-form');
  if (!form) return;
  var steps = Array.prototype.slice.call(form.querySelectorAll('.booking-step'));
  var current = 0;
  var bar = document.getElementById('booking-progress-bar');
  var label = document.getElementById('booking-step-label');
  var back = document.getElementById('booking-back');
  var next = document.getElementById('booking-next');
  var submit = document.getElementById('booking-submit');
  var error = document.getElementById('booking-error');
  var dateInput = document.getElementById('booking-date');
  var today = new Date();
  var localToday = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0,10);
  dateInput.min = localToday;

  function showStep(n) {
    current = n;
    steps.forEach(function(step, i){ step.hidden = i !== current; });
    bar.style.width = ((current + 1) * 20) + '%';
    label.textContent = 'Paso ' + (current + 1) + ' de 5';
    back.hidden = current === 0;
    next.hidden = current === steps.length - 1;
    submit.hidden = current !== steps.length - 1;
    error.textContent = '';
  }
  function validCurrentStep() {
    var fields = steps[current].querySelectorAll('input, select, textarea');
    for (var i = 0; i < fields.length; i++) {
      if (!fields[i].checkValidity()) {
        fields[i].reportValidity();
        return false;
      }
    }
    return true;
  }
  next.addEventListener('click', function(){
    if (validCurrentStep()) showStep(Math.min(current + 1, steps.length - 1));
  });
  back.addEventListener('click', function(){ showStep(Math.max(current - 1, 0)); });
  form.addEventListener('submit', function(e){
    e.preventDefault();
    if (!validCurrentStep()) return;
    var get = function(id){ return document.getElementById(id).value.trim(); };
    var date = get('booking-date');
    var parts = date.split('-');
    if (parts.length === 3) date = parts[2] + '/' + parts[1] + '/' + parts[0];
    var message = [
      'Hola, quiero solicitar una cita de fisioterapia.',
      '',
      'Servicio: ' + get('booking-service'),
      'Profesional: ' + get('booking-professional'),
      'Día preferido: ' + date,
      'Hora preferida: ' + get('booking-time'),
      'Nombre: ' + get('booking-name'),
      'Teléfono: ' + get('booking-phone'),
      'Correo: ' + (get('booking-email') || 'No indicado'),
      'Motivo: ' + get('booking-reason'),
      '',
      'Entiendo que la cita queda pendiente de confirmación.'
    ].join('\n');
    var whatsappUrl = 'https://wa.me/34675158874?text=' + encodeURIComponent(message);
    window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
  });
  showStep(0);
})();
</script>

