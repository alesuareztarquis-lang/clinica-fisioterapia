<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Clínica de Fisioterapia · Joel Díaz & Alejandro Suárez</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:ital,wght@1,400;1,500&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#eef0f3;--surface:#fff;--soft:#e3e7ec;--ink:#0b1f3f;--muted:#5a6781;--line:#d5dbe3;--navy:#0b1f3f;--blue:#2b6ef2;--btn:#0b1f3f;--btn-ink:#fff}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d131f;--surface:#151d2c;--soft:#1b2537;--ink:#eaf0fa;--muted:#98a6bd;--line:#27344a;--btn:#2b6ef2}}
:root[data-theme="dark"]{--bg:#0d131f;--surface:#151d2c;--soft:#1b2537;--ink:#eaf0fa;--muted:#98a6bd;--line:#27344a;--btn:#2b6ef2}
*,*::before,*::after{box-sizing:inherit}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:16px/1.6 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
.wrap{width:min(1160px,calc(100% - 40px));margin:0 auto}
.btn{display:inline-flex;align-items:center;gap:12px;padding:10px 10px 10px 22px;border-radius:999px;font-weight:600;font-size:.95rem;border:1px solid transparent;transition:transform .2s}
.btn:hover{transform:translateY(-2px)}
.btn .arr{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--blue);color:#fff;font-size:1rem}
.btn.dark{background:var(--btn);color:var(--btn-ink)}
.btn.white{background:#fff;color:#0b1f3f}
.btn.ghost{border-color:rgba(255,255,255,.55);color:#fff}
.btn.ghost .arr{background:#fff;color:#0b1f3f}
.hero{position:relative;margin:16px;min-height:700px;border-radius:30px;overflow:hidden;color:#fff;background:#0b1f3f url("data:image/jpeg;base64,") center/cover no-repeat;display:flex;flex-direction:column;justify-content:flex-end}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,31,63,.94) 0%,rgba(11,31,63,.72) 45%,rgba(11,31,63,.12) 100%)}
.nav{position:absolute;z-index:2;top:20px;left:50%;transform:translateX(-50%);width:min(1100px,calc(100% - 32px));display:flex;align-items:center;justify-content:space-between;gap:16px;background:#fff;color:#0b1f3f;border-radius:999px;padding:8px 10px 8px 22px}
.nav img{height:46px;width:auto}
.nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0;font-size:.92rem;font-weight:500}
.nav ul a:hover{color:var(--blue)}
.hero-in{position:relative;z-index:1;padding:0 clamp(24px,6vw,84px);margin-bottom:34px}
h1{font-size:clamp(2.2rem,5.2vw,4.1rem);line-height:1.06;letter-spacing:-.03em;margin:0;max-width:680px;font-weight:600}
h1 em{display:block;font-family:Fraunces,Georgia,serif;font-weight:400;letter-spacing:-.01em;margin-top:10px}
.lead{max-width:560px;margin:22px 0 0;color:#dbe4f3}
.cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:30px}
.tags{position:relative;z-index:1;display:flex;gap:28px;justify-content:flex-end;flex-wrap:wrap;padding:0 clamp(24px,6vw,84px) 34px}
.tags div{border-left:2px solid #fff;padding-left:14px;max-width:230px;font-weight:500;line-height:1.35}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;padding:46px 0}
.stat{display:flex;align-items:center;gap:14px}
.stat b{font-size:clamp(2.2rem,4.5vw,3.4rem);letter-spacing:-.04em;font-weight:500;line-height:1}
.stat span{color:var(--muted);font-size:.88rem;line-height:1.35}
section{padding:64px 0}
.eyebrow{color:var(--blue);font-weight:600;letter-spacing:.14em;text-transform:uppercase;font-size:.75rem}
h2{font-size:clamp(1.8rem,3.6vw,2.8rem);line-height:1.1;letter-spacing:-.03em;margin:10px 0 14px;font-weight:600}
h2 em{font-family:Fraunces,Georgia,serif;font-weight:400}
.intro{color:var(--muted);max-width:620px;margin:0 0 34px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:24px;overflow:hidden;display:flex;flex-direction:column}
.card img{width:100%;aspect-ratio:4/3;object-fit:cover}
.card div{padding:22px;display:flex;flex-direction:column;gap:8px;flex:1}
.card h3{margin:0;font-size:1.2rem}
.card p{margin:0;color:var(--muted);font-size:.95rem}
.split{display:grid;grid-template-columns:1.1fr .9fr;gap:44px;align-items:center}
.split img{border-radius:28px;width:100%;aspect-ratio:3/2;object-fit:cover}
.checks{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:10px;color:var(--muted)}
.checks li::before{content:"✓";color:var(--blue);font-weight:700;margin-right:10px}
.team{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
.person{background:var(--surface);border:1px solid var(--line);border-radius:24px;padding:28px;display:flex;gap:20px;align-items:center}
.avatar{flex:none;object-fit:cover;width:104px;height:104px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:700;font-size:1.4rem}
.person h3{margin:0}.person p{margin:4px 0 0;color:var(--muted);font-size:.95rem}
.book{background:#0b1f3f;color:#fff;border-radius:30px;padding:clamp(28px,5vw,56px);display:grid;grid-template-columns:1.1fr .9fr;gap:36px;align-items:center}
.book p{color:#c9d5ea}
.card .svc-list{list-style:none;margin:6px 0 0;padding:14px 0 0;border-top:1px solid var(--line);display:grid;gap:14px}
.card .svc-list li{display:flex;gap:14px;align-items:flex-start}
.card .svc-list img{flex:none;width:76px;height:76px;aspect-ratio:1;border-radius:14px;object-fit:cover}
.card .svc-list span{font-size:.88rem;color:var(--muted);line-height:1.45}
.card .svc-list b{display:block;color:var(--ink);font-size:.98rem;margin-bottom:2px}
.js .card .svc-list li{opacity:0;transform:translateY(28px);transition:opacity .7s ease var(--d,0s),transform .7s ease var(--d,0s)}
.js .card .svc-list li img{transform:scale(.8);transition:transform .8s cubic-bezier(.2,.8,.2,1) var(--d,0s)}
.js .card .svc-list li.in{opacity:1;transform:none}
.js .card .svc-list li.in img{transform:none}
@media (prefers-reduced-motion:reduce){.js .card .svc-list li,.js .card .svc-list li img{opacity:1;transform:none;transition:none}}
.card .fig{margin:6px 0 0;display:grid;gap:10px}
.card .fig img{border-radius:16px}
.card .fig figcaption{font-size:.88rem;color:var(--muted);line-height:1.45}
.card .fig b{display:block;color:var(--ink);font-size:.98rem;margin-bottom:2px}
.js .reveal{opacity:0;transform:translateY(28px);transition:opacity .7s ease,transform .7s ease}
.js .reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.js .reveal{opacity:1;transform:none;transition:none}}
.card .svc-list.dots{list-style:disc;padding:14px 0 0 20px}
.card .svc-list.dots li{display:list-item}
.card .svc-list.dots li::marker{color:var(--blue)}
.book-img{grid-column:1/-1;width:100%;aspect-ratio:21/8;object-fit:cover;border-radius:20px}
.callout{background:#0b1f3f;color:#fff;border-radius:24px;padding:clamp(22px,4vw,38px);margin:0 0 34px;border-left:6px solid var(--blue)}
.callout .pill{display:inline-block;background:var(--blue);color:#fff;border-radius:999px;padding:4px 14px;font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}
.callout p{font-size:clamp(1.35rem,3vw,2.15rem);line-height:1.2;margin:0;font-weight:600;letter-spacing:-.02em}
.callout strong{color:#8fb2ff}
.callout small{color:#c9d5ea;font-size:.95rem}
.steps{display:grid;gap:14px}
.step{display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.07);border-radius:18px;padding:16px}
.step i{flex:none;width:30px;height:30px;border-radius:50%;background:var(--blue);display:grid;place-items:center;font-style:normal;font-weight:700}
.step span{color:#c9d5ea;font-size:.92rem}
.contact{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.info{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:22px}
.info b{display:block;margin-bottom:6px}.info span{color:var(--muted);overflow-wrap:anywhere}
footer{border-top:1px solid var(--line);padding:30px 0 44px;color:var(--muted);font-size:.88rem}
footer .wrap{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
footer img{height:44px;background:#fff;border-radius:12px;padding:4px 10px}
@media (max-width:900px){.nav ul{display:none}.nav{padding-left:16px}.stats{grid-template-columns:1fr 1fr}.grid3,.team,.contact{grid-template-columns:1fr}.split,.book{grid-template-columns:1fr}.hero{min-height:640px}.tags{justify-content:flex-start}}

/* Cuestionario de reserva en cinco pasos */
.booking-wizard{padding:54px 0 64px;background:var(--surface);color:var(--ink)}
.booking-card{max-width:820px;margin:0 auto;background:var(--bg);border:1px solid var(--line);border-radius:22px;padding:clamp(20px,4vw,38px)}
.booking-card h2{margin:8px 0 10px}
.booking-intro{color:var(--muted);line-height:1.65;margin-bottom:22px}
.booking-progress{height:6px;background:var(--line);border-radius:99px;overflow:hidden;margin:20px 0 8px}
.booking-progress span{display:block;height:100%;width:20%;background:var(--blue);transition:width .2s}
.booking-step-label{font-size:.88rem;color:var(--muted);margin-bottom:22px}
.booking-fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.booking-field{display:flex;flex-direction:column;gap:7px;min-width:0}
.booking-field.full{grid-column:1/-1}
.booking-field label{font-weight:600;font-size:.94rem}
.booking-field input,.booking-field select,.booking-field textarea{font:inherit;width:100%;box-sizing:border-box;padding:13px 14px;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--ink)}
.booking-field textarea{min-height:110px;resize:vertical}
.booking-buttons{display:flex;justify-content:space-between;gap:12px;margin-top:26px;flex-wrap:wrap}
.booking-buttons button{cursor:pointer;border:0;border-radius:999px;padding:13px 21px;font:inherit;font-weight:600}
.booking-next,.booking-submit{background:var(--navy);color:#fff}
.booking-back{background:var(--soft);color:var(--ink)}
.booking-note{font-size:.86rem;line-height:1.55;color:var(--muted);margin-top:18px}
.booking-error{color:#b42318;font-size:.9rem;margin-top:12px}
.booking-step[hidden]{display:none!important}
@media(max-width:600px){.booking-fields{grid-template-columns:1fr}.booking-field.full{grid-column:auto}.booking-card{border-radius:16px}}

</style>
<script>document.documentElement.classList.add("js")</script>
</head>
<body>
<header class="hero" id="inicio">
<nav class="nav" aria-label="Principal">
<a href="#inicio"><img src="data:image/png;base64," alt="Clínica de Fisioterapia, Joel Díaz y Alejandro Suárez"></a>
<ul><li><a href="#tratamientos">Tratamientos</a></li><li><a href="#espacios">La clínica</a></li><li><a href="#equipo">Equipo</a></li><li><a href="#reservas">Reservas</a></li><li><a href="#contacto">Contacto</a></li></ul>
<a class="btn dark" href="#reservas" style="background:#0b1f3f;color:#fff">Reservar cita <span class="arr">→</span></a>
</nav>
<div class="hero-in">
<h1>Alivia el dolor, recupera movilidad y fuerza<em>Vuelve a moverte</em></h1>
<p class="lead">Fisioterapia personalizada, rehabilitación en gimnasio y recuperación en wellness, con atención individual de Joel Díaz y Alejandro Suárez.</p>
<div class="cta"><a class="btn white" href="#reservas">Reservar cita <span class="arr">→</span></a><a class="btn ghost" href="#tratamientos">Nuestros servicios <span class="arr">→</span></a></div>
</div>
<div class="tags" style="margin-top:34px"><div>Empezamos con una valoración y diseñamos tu plan</div><div>Fisioterapia, recuperación, rendimiento y bienestar</div></div>
</header>
<main>
<div class="wrap stats">
<div class="stat"><b>2</b><span>Fisioterapeutas a tu lado</span></div>
<div class="stat"><b>4</b><span>Áreas: fisioterapia, recuperación, rendimiento y bienestar</span></div>
<div class="stat"><b>3</b><span>Espacios: boxes, gimnasio y wellness</span></div>
<div class="stat"><b>1:1</b><span>Atención individual</span></div>
</div>
<section id="tratamientos"><div class="wrap">
<div class="eyebrow">Cómo podemos ayudarte</div>
<h2>Tratamientos pensados <em>para ti</em></h2>
<div class="callout"><p>Cada persona y cada lesión son distintas, por eso empezamos con una <strong>valoración</strong> y diseñamos el <strong>plan que necesitas</strong>.</p></div>
<div class="grid3">
<article class="card"><img src="data:image/jpeg;base64," alt="Box de tratamiento de fisioterapia" loading="lazy"><div><h3>Fisioterapia</h3><p>Valoración y tratamiento individual en box, con un plan adaptado a tus objetivos.</p><ul class="svc-list"><li><img src="data:image/jpeg;base64," alt="Terapia manual en la espalda" loading="lazy"><span><b>Terapia manual</b>Técnicas con las manos para reducir el dolor, soltar la tensión muscular y recuperar movilidad.</span></li><li><img src="data:image/jpeg;base64," alt="Tratamiento con tecnología avanzada en la rodilla" loading="lazy"><span><b>Tecnología avanzada</b>Radiofrecuencia y electroterapia que actúan sobre los tejidos de forma controlada para aliviar el dolor y favorecer la recuperación de lesiones.</span></li><li><img src="data:image/jpeg;base64," alt="Punción en la espalda" loading="lazy"><span><b>Punción</b>Aguja fina aplicada sobre puntos de tensión muscular para aliviar el dolor y mejorar la movilidad.</span></li></ul></div></article>
<article class="card"><img src="data:image/jpeg;base64," alt="Gimnasio de rehabilitación" loading="lazy"><div><h3>Rehabilitación en gimnasio</h3><p>Ejercicio terapéutico y readaptación con material profesional para recuperar fuerza y confianza.</p><ul class="svc-list dots"><li><span><b>El mejor trabajo, de la mano de los profesionales de nuestra clínica</b>Sesiones guiadas por nuestro equipo para recuperar fuerza y volver a tu actividad con confianza.</span></li><li><span><b>Actualizados en la evidencia del ejercicio terapéutico</b>Aplicamos la evidencia científica actual para diseñar ejercicios seguros y adaptados a ti.</span></li></ul></div></article>
<article class="card"><img src="data:image/jpeg;base64," alt="Sala de recuperación y wellness" loading="lazy"><div><h3>Recuperación y wellness</h3><p>Presoterapia, sauna y baños de contraste para acelerar la recuperación y reducir la carga muscular.</p><ul class="svc-list"><li><img src="data:image/jpeg;base64," alt="Sillones con botas de presoterapia" loading="lazy"><span><b>Presoterapia</b>Botas de compresión con presión progresiva y ajustable, habitualmente entre 20 y 80 mmHg, que favorecen el retorno venoso y alivian la sensación de piernas cargadas.</span></li><li><img src="data:image/jpeg;base64," alt="Sauna de madera con luz cálida" loading="lazy"><span><b>Sauna</b>Calor seco a temperatura controlada, de unos 70-90 °C, para relajar la musculatura y aliviar la tensión.</span></li><li><img src="data:image/jpeg;base64," alt="Baños de agua fría con hielo" loading="lazy"><span><b>Baños de contraste</b>Alternamos agua fría (10-15 °C) y agua caliente (38-40 °C) para ayudar a recuperarte tras el esfuerzo y reducir la fatiga muscular.</span></li></ul></div></article>
</div></div></section>
<section id="espacios" style="background:var(--soft)"><div class="wrap split">
<div><div class="eyebrow">La clínica</div><h2>Un espacio cuidado para <em>tu recuperación</em></h2>
<p class="intro" style="margin-bottom:0">Una recepción acogedora, boxes de tratamiento, gimnasio de rehabilitación y una zona de recuperación y wellness, todo en un mismo lugar.</p>
<ul class="checks"><li>Atención cercana desde la primera visita</li><li>Valoración inicial con tu fisioterapeuta</li><li>Rehabilitación y recuperación bajo un mismo plan</li></ul></div>
<img src="data:image/jpeg;base64," alt="Recepción de la clínica" loading="lazy"></div></section>
<section id="equipo"><div class="wrap">
<div class="eyebrow">Cercanía y profesionalidad</div><h2>Las personas detrás <em>de tu recuperación</em></h2>
<p class="intro">Queremos que te sientas escuchado desde la primera visita y que entiendas cada paso de tu proceso.</p>
<div class="team">
<div class="person"><img class="avatar" src="data:image/jpeg;base64," alt="Joel Díaz, fisioterapeuta" loading="lazy"><div><h3>Joel Díaz</h3><p>Fisioterapeuta especializado en rehabilitación, ejercicio terapéutico y fisioterapia cardiorrespiratoria.</p></div></div>
<div class="person"><img class="avatar" src="data:image/jpeg;base64," alt="Alejandro Suárez, fisioterapeuta" loading="lazy"><div><h3>Alejandro Suárez</h3><p>Fisioterapeuta especializado en terapia manual, ecografía, rehabilitación y ejercicio terapéutico.</p></div></div>
</div></div></section>
<section id="reservas"><div class="wrap"><div class="book"><img class="book-img" src="data:image/jpeg;base64," alt="Recepción de la clínica" loading="lazy">
<div><div class="eyebrow">Reserva en pocos pasos</div><h2>Tu próxima cita, <em>cuando te venga bien</em></h2>
<p>Elige el servicio, el profesional y la hora, y cuéntanos el motivo de tu consulta para que nos preparemos antes de verte.</p>
<a class="btn white" href="#formulario-reserva" style="margin-top:12px">Reservar cita <span class="arr">→</span></a></div>
<div class="steps">
<div class="step"><i>1</i><div><b>Valoración inicial</b><br><span>Si es tu primera vez, empiezas con una valoración.</span></div></div>
<div class="step"><i>2</i><div><b>Plan personalizado</b><br><span>Tu fisioterapeuta define el tratamiento que necesitas.</span></div></div>
<div class="step"><i>3</i><div><b>Gimnasio y wellness</b><br><span>Se activan cuando tu fisioterapeuta lo indique.</span></div></div>
</div></div></div></section>

<section class="booking-wizard" id="formulario-reserva">
  <div class="wrap">
    <div class="booking-card">
      <div class="eyebrow">Solicitud de cita</div>
      <h2>Reserva tu <em>cita</em></h2>
      <p class="booking-intro">Completa estos cinco pasos. Al final se abrirá WhatsApp con tu solicitud preparada para enviárnosla. La cita no queda confirmada hasta que la clínica te responda.</p>
      <div class="booking-progress" aria-hidden="true"><span id="booking-progress-bar"></span></div>
      <div class="booking-step-label" id="booking-step-label">Paso 1 de 5</div>
      <form id="booking-form">
        <div class="booking-step" data-step="0">
          <h3>1. ¿Qué servicio necesitas?</h3>
          <div class="booking-fields">
            <div class="booking-field full">
              <label for="booking-service">Servicio *</label>
              <select id="booking-service" name="service" required>
                <option value="">Selecciona un servicio</option>
                <option>Valoración inicial</option>
                <option>Fisioterapia y terapia manual</option>
                <option>Rehabilitación y ejercicio terapéutico</option>
                <option>Recuperación deportiva</option>
                <option>Ecografía / valoración funcional</option>
                <option>Gimnasio y wellness</option>
                <option>No estoy seguro/a; necesito orientación</option>
              </select>
            </div>
          </div>
        </div>
        <div class="booking-step" data-step="1" hidden>
          <h3>2. Elige profesional</h3>
          <div class="booking-fields">
            <div class="booking-field full">
              <label for="booking-professional">¿Con quién quieres la cita? *</label>
              <select id="booking-professional" name="professional" required>
                <option value="">Selecciona una opción</option>
                <option>Joel Díaz</option>
                <option>Alejandro Suárez</option>
                <option>Me da igual / recomendadme</option>
              </select>
            </div>
          </div>
        </div>
        <div class="booking-step" data-step="2" hidden>
          <h3>3. Día y hora preferidos</h3>
          <div class="booking-fields">
            <div class="booking-field">
              <label for="booking-date">Día preferido *</label>
              <input id="booking-date" name="date" type="date" required>
            </div>
            <div class="booking-field">
              <label for="booking-time">Hora preferida *</label>
              <select id="booking-time" name="time" required>
                <option value="">Selecciona una hora</option>
                <option>09:00</option><option>09:30</option>
                <option>10:00</option><option>10:30</option>
                <option>11:00</option><option>11:30</option>
                <option>12:00</option><option>12:30</option>
                <option>13:00</option><option>13:30</option>
                <option>15:00</option><option>15:30</option>
                <option>16:00</option><option>16:30</option>
                <option>17:00</option><option>17:30</option>
                <option>18:00</option><option>18:30</option>
              </select>
            </div>
          </div>
          <p class="booking-note">La fecha y la hora son preferencias, no disponibilidad confirmada. La clínica confirmará contigo la cita.</p>
        </div>
        <div class="booking-step" data-step="3" hidden>
          <h3>4. Tus datos</h3>
          <div class="booking-fields">
            <div class="booking-field">
