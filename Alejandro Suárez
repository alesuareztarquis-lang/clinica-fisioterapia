if(!('IntersectionObserver' in window)){li.forEach(function(e){e.classList.add('in')});return}
var o=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');o.unobserve(x.target)}})},{threshold:0.3,rootMargin:'0px 0px -8% 0px'});
li.forEach(function(e,i){e.style.setProperty('--d',(i*0.18)+'s');o.observe(e)})})();
